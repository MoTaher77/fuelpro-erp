{
  "name": "fuelpro-v2",
  "private": true,
  "type": "module",
  "description": "FuelPro v2: one TypeScript core, three run modes (server, desktop, phone). See docs/ARCHITECTURE-V2.md.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node apps/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3"
  }
}
