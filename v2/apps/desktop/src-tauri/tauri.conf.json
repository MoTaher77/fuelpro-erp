{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FuelPro",
  "version": "0.1.0",
  "identifier": "com.fuelpro.desktop",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "" },
  "app": {
    "windows": [{ "title": "FuelPro", "width": 1200, "height": 820, "minWidth": 380, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Business",
    "shortDescription": "FuelPro — fuel station accounting, offline"
  }
}
