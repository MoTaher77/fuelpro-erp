# FuelPro behind Caddy: automatic HTTPS (Let's Encrypt) for __DOMAIN__, everything forwarded to the app on 127.0.0.1:3000.
# The app itself compresses and sets its security headers (CSP, HSTS, nosniff, frame-deny).
{
	email __EMAIL__
	# HTTP/1.1 and HTTP/2 only: the firewall opens TCP 443, not UDP 443, so HTTP/3 (QUIC) would be advertised but unreachable
	servers {
		protocols h1 h2
	}
}

__DOMAIN__ {
	reverse_proxy 127.0.0.1:3000 {
		# Caddy sets X-Forwarded-For to the real client address by itself (incoming values are not trusted); the app reads the last hop (TRUST_PROXY=1)
		# not behind Cloudflare here: drop a client-supplied CF-Connecting-IP, which the app would otherwise trust first
		header_up -CF-Connecting-IP
	}
	request_body {
		max_size 2MB
	}
	# access log to the journal (journalctl -u caddy): no log file whose owner could stop Caddy from starting
	log
}
