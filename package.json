{
  "name": "fuelpro",
  "version": "0.37.1",
  "description": "Multi-tenant fuel station management server (Node 22+; the SQLite mode needs no installed package)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "reset-2fa": "node --disable-warning=ExperimentalWarning scripts/reset-2fa.js",
    "lint": "eslint .",
    "test:artifact": "node --disable-warning=ExperimentalWarning --import ./web/sqljs-hook.mjs --test --test-skip-pattern=\"[Bb]ackup\" test/*.test.js",
    "build:artifact": "node --disable-warning=ExperimentalWarning web/build.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test-e2e/*.test.js",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench-api.js",
    "bench:pages": "node --disable-warning=ExperimentalWarning scripts/bench-pages.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "sql.js": "1.10.3",
    "typescript": "5.9.3"
  }
}
