PORT=3000
HOST=0.0.0.0
DB_PATH=./data/fuelpro.db
# Set to 1 when served over HTTPS (adds Secure cookies + HSTS)
COOKIE_SECURE=1
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=1
# Public address of the app. Password-reset links are built from this (never from the request's Host header)
APP_URL=https://fuel.example.com
# Long random string. Encrypts two-factor secrets in the database (AES-256-GCM). Keep it stable and backed up.
APP_SECRET=change-me-to-64-random-characters
# Outgoing mail for password resets. Without SMTP_HOST, emails are printed to the server log.
SMTP_HOST=smtp.example.com
SMTP_PORT=587            # 465 = implicit TLS; 587 = STARTTLS (required unless SMTP_ALLOW_PLAIN=1)
SMTP_USER=apikey
SMTP_PASS=secret
MAIL_FROM=no-reply@fuel.example.com
MAIL_FROM_NAME=FuelPro
